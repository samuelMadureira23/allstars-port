+/* PORT_GSTACK="8,20,40": at each listed second, print every guest thread's
+ * cia/lr and back-chain (runtime: ppu_debug_dump_guest_stacks) to stderr. Two
+ * or more samples show which threads are parked (same chain) vs progressing. */
+extern "C" void ppu_debug_dump_guest_stacks(FILE* f);
+
+static DWORD WINAPI gstack_watchdog(LPVOID arg)
+{
+    const char* spec = (const char*)arg;
+    int prev = 0;
+    for (const char* p = spec; *p; ) {
+        int t = atoi(p);
+        if (t > prev) { Sleep((DWORD)(t - prev) * 1000); prev = t; }
+        fprintf(stderr, "[GSTACK] ===== t=%ds =====\n", t);
+        ppu_debug_dump_guest_stacks(stderr);
+        while (*p && *p != ',') p++;
+        if (*p == ',') p++;
+    }
+    return 0;
+}
+
+#ifdef _WIN32
+/* Last-chance crash report: without it a host fault inside lifted code or an
+ * HLE handler just ends the process with nothing in the log. */
+extern "C" uint32_t    g_last_hle_nid;
+extern "C" const char* g_last_hle_name;
+
+static LONG WINAPI port_crash_filter(EXCEPTION_POINTERS* ep)
+{
+    static volatile LONG once = 0;
+    if (InterlockedExchange(&once, 1)) return EXCEPTION_CONTINUE_SEARCH;
+    HMODULE self = GetModuleHandleA(NULL);
+    const EXCEPTION_RECORD* er = ep->ExceptionRecord;
+    fprintf(stderr, "\n[CRASH] code=0x%08lX rip=%p (exe rva 0x%llX) fault addr=0x%llX%s; last HLE 0x%08X %s\n",
+            er->ExceptionCode, er->ExceptionAddress,
+            (unsigned long long)((char*)er->ExceptionAddress - (char*)self),
+            er->NumberParameters > 1 ? (unsigned long long)er->ExceptionInformation[1] : 0ull,
+            er->NumberParameters > 1 && vm_base && er->ExceptionInformation[1] >= (ULONG_PTR)vm_base &&
+                er->ExceptionInformation[1] < (ULONG_PTR)vm_base + 0x100000000ull ? " (inside guest VM)" : "",
+            g_last_hle_nid, g_last_hle_name ? g_last_hle_name : "");
+    ppu_debug_dump_guest_stacks(stderr);
+    fflush(stderr);
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+#endif
