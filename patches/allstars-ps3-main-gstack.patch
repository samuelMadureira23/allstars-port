+/* PORT_GSTACK="8,20,40": at each listed second, print every guest thread's
+ * cia/lr and back-chain (runtime: ppu_debug_dump_guest_stacks) to stderr. Two
+ * or more samples show which threads are parked (same chain) vs progressing. */
+extern "C" void ppu_debug_dump_guest_stacks(FILE* f);
+
+static DWORD WINAPI gstack_watchdog(LPVOID arg)
+{
+    const char* spec = (const char*)arg;
+    int prev = 0;
+    for (const char* p = spec; *p; ) {
+        int t = atoi(p);
+        if (t > prev) { Sleep((DWORD)(t - prev) * 1000); prev = t; }
+        fprintf(stderr, "[GSTACK] ===== t=%ds =====\n", t);
+        ppu_debug_dump_guest_stacks(stderr);
+        while (*p && *p != ',') p++;
+        if (*p == ',') p++;
+    }
+    return 0;
+}
+
 static void harness_guest_caller(uint32_t opd, uint64_t a0, uint64_t a1,
                                  uint64_t a2, uint64_t a3, uint64_t a4,
                                  uint64_t a5, uint64_t a6, uint64_t a7)
@@ -369,6 +389,8 @@ int main(int argc, char** argv)
      * until the title registers its vblank and flip handlers during init. */
     g_ps3_guest_caller = harness_guest_caller;
     CreateThread(NULL, 4u * 1024 * 1024, frame_clock, NULL, 0, NULL);
+    if (const char* gs = getenv("PORT_GSTACK"); gs && *gs)
+        CreateThread(NULL, 0, gstack_watchdog, (LPVOID)gs, 0, NULL);
 
