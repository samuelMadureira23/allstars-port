From 67e8274a3e53d243b92a7b37197c4a9b420d6d91 Mon Sep 17 00:00:00 2001
From: samuel <samuelMadureira23@users.noreply.github.com>
Date: Wed, 14 Oct 2026 09:50:42 -0300
Subject: [PATCH 5/9] gcm: GCM_PARK_WAIT (honour FIFO self-jump parks); sail:
 SAIL_SKIP_MOVIES

- GCM_PARK_WAIT=1: stay parked on a self-JUMP until the title patches it (both
  the jump-park resync and the stuck-get watchdog skipped PSASBR's SPU-filled
  segments, losing per-frame label writes; its movie loop then waited one
  label short forever). Also log the words at a stuck get.
- SAIL_SKIP_MOVIES=1: no decoder behind GetFrame2, so report end of stream
  (PLAYER_STATE_CHANGED -> OPENED) right after Start; PSASBR's handler maps
  that to movie-done and continues to the frontend.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/codec/cellSail.c   | 13 +++++++++++++
 libs/video/cellGcmSys.c | 24 ++++++++++++++++++++++--
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/libs/codec/cellSail.c b/libs/codec/cellSail.c
index 6f523a8..7f67d9a 100644
--- a/libs/codec/cellSail.c
+++ b/libs/codec/cellSail.c
@@ -189,6 +189,19 @@ s32 cellSailPlayerStart(CellSailPlayerHandle handle)
     /* Immediately signal finished since we don't play anything */
     s_sail_players[_sp].state = CELL_SAIL_PLAYER_STATE_FINISHED;
     sail_notify(_sp, SAIL_EV_CALL_COMPLETED, SAIL_CALL_START, 0);
+    /* SAIL_SKIP_MOVIES=1: there is no decoder behind GetFrame2, so a title that
+     * waits for the stream to end waits forever (PSASBR's attract movie pump:
+     * no frame -> no flip -> its render thread polls GetFlipStatus). Report the
+     * session as over the way the player does at end of stream: a
+     * PLAYER_STATE_CHANGED back to OPENED (SDK state 4; minor/arg0 = state).
+     * PSASBR's handler maps "OPENED while starting" to its movie-done state. */
+    { static int skip = -1;
+      if (skip < 0) { const char* e = getenv("SAIL_SKIP_MOVIES"); skip = e ? atoi(e) : 0; }
+      if (skip) {
+          enum { SAIL_EV_PLAYER_STATE_CHANGED = 3, SDK_STATE_OPENED = 4 };
+          printf("[cellSail] SAIL_SKIP_MOVIES: reporting end of stream (state -> OPENED)\n");
+          sail_notify(_sp, SAIL_EV_PLAYER_STATE_CHANGED, SDK_STATE_OPENED, SDK_STATE_OPENED);
+      } }
     return CELL_OK;
 }
 
diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index de49246..6ed2032 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1488,7 +1488,15 @@ static void gcm_rsx_process_fifo_unlocked(void)
                    * park standing -- it only patches a park when it reuses that
                    * block. Waiting for a patch that will not come freezes the
                    * FIFO for the rest of the run, so follow the write head. */
-                  if (put != s_fifo_getoff) { gcm_fifo_dump_around(s_fifo_getoff);
+                  /* GCM_PARK_WAIT=1: behave like the RSX and stay parked until the
+                   * title patches the jump. PSASBR parks at the end of a segment,
+                   * writes the next one elsewhere (moving `put`), and only then
+                   * patches the park; resyncing to `put` in that window skipped
+                   * the segment holding its per-frame label write and wedged the
+                   * movie loop one frame short. */
+                  static int park_wait = -1;
+                  if (park_wait < 0) { const char* e = getenv("GCM_PARK_WAIT"); park_wait = e ? atoi(e) : 0; }
+                  if (put != s_fifo_getoff && !park_wait) { gcm_fifo_dump_around(s_fifo_getoff);
                                               gcm_fifo_resync_why("jump-park", &s_fifo_getoff, put); }
                   break;
               }
@@ -1724,8 +1732,20 @@ static void gcm_rsx_process_fifo_unlocked(void)
       } else burned = 0; }
 
     { static u32 last = 0xFFFFFFFFu; static int stuck = 0;
-      if (s_fifo_getoff == last && s_fifo_getoff != put) {
+      /* Under GCM_PARK_WAIT a self-JUMP at `get` is a legitimate RSX stall: the
+       * title patches it when it links the next segment. Don't resync it away. */
+      static int park_wait2 = -1;
+      if (park_wait2 < 0) { const char* e = getenv("GCM_PARK_WAIT"); park_wait2 = e ? atoi(e) : 0; }
+      int parked = 0;
+      if (park_wait2) { u32 ea = gcm_io2ea(s_fifo_getoff);
+                        parked = ea && vm_read32(ea) == (0x20000000u | s_fifo_getoff); }
+      if (s_fifo_getoff == last && s_fifo_getoff != put && !parked) {
           if (++stuck >= 8) { gcm_fifo_dump_around(s_fifo_getoff);
+                             { u32 ea = gcm_io2ea(s_fifo_getoff); static int nd = 0;
+                               if (ea && nd++ < 12) {
+                                   fprintf(stderr, "[cellGcmSys] stuck at get=0x%08X:", s_fifo_getoff);
+                                   for (int k = 0; k < 8; k++) fprintf(stderr, " %08X", vm_read32(ea + k * 4));
+                                   fprintf(stderr, "%c", 10); } }
                              gcm_fifo_resync_why("stuck-get", &s_fifo_getoff, put); stuck = 0; }
       } else { stuck = 0; last = s_fifo_getoff; } }
 
