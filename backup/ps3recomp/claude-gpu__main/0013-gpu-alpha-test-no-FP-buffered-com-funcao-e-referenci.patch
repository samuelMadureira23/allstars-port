+/* Whether a draw needs the alpha-test variant of its pipeline: test enabled
+ * and the function is not ALWAYS. NO_ALPHATEST=1 turns it off for A/B. */
+static int dr_atest(const D3D12DrawRecord* dr)
+{
+    static int off = -1;
+    if (off < 0) off = getenv("NO_ALPHATEST") ? 1 : 0;
+    if (off || !((dr->alpha_ctl >> 16) & 1u)) return 0;
+    return ((dr->alpha_ctl >> 8) & 0x07u) != 7u;
+}
