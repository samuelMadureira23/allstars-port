                 /* Per-draw viewport: the guest rect when sane, else the
diff --git a/libs/video/rsx_fp_decompiler.c b/libs/video/rsx_fp_decompiler.c
index 563a5b4..3c78978 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -1027,6 +1027,57 @@ int rsx_fp_apply_alpha_test_buffered(
     return 1;
 }
 
+/* Alpha test with BOTH the function and the reference read from PSConstants
+ * (fp_alpha.x = ref, fp_alpha.y = CELL_GCM func - 0x200), so a program needs
+ * one pipeline with the test and one without -- not one per func/ref pair.
+ * The D3D12 backend only applies this to draws whose alpha test is enabled,
+ * keeping early depth for every other draw. */
+int rsx_fp_apply_alpha_test_dynamic(char* hlsl, u32 out_size)
+{
+    if (!hlsl || out_size == 0)
+        return -1;
+    char* marker = NULL;
+    for (char* p = strstr(hlsl, "    return "); p;
+         p = strstr(p + 1, "    return "))
+        marker = p;
+    if (!marker)
+        return -1;
+    char* expression = marker + strlen("    return ");
+    char* terminator = strstr(expression, ";\n}\n");
+    if (!terminator || terminator == expression ||
+        (size_t)(terminator - expression) >= 96)
+        return -1;
+    char output[96];
+    memcpy(output, expression, (size_t)(terminator - expression));
+    output[terminator - expression] = '\0';
+
+    const int mrt = fp_returns_struct(hlsl);
+    char suffix[768];
+    const int n = snprintf(suffix, sizeof(suffix),
+        "    %s _rsx_out = %s;\n"
+        "    const float _rsx_a = %s.a;\n"
+        "    const float _rsx_alpha_ref = fp_alpha.x;\n"
+        "    const int _rsx_af = (int)(fp_alpha.y + 0.5);\n"
+        "    bool _rsx_pass = true;\n"
+        "    if      (_rsx_af == 0) _rsx_pass = false;\n"
+        "    else if (_rsx_af == 1) _rsx_pass = _rsx_a <  _rsx_alpha_ref;\n"
+        "    else if (_rsx_af == 2) _rsx_pass = _rsx_a == _rsx_alpha_ref;\n"
+        "    else if (_rsx_af == 3) _rsx_pass = _rsx_a <= _rsx_alpha_ref;\n"
+        "    else if (_rsx_af == 4) _rsx_pass = _rsx_a >  _rsx_alpha_ref;\n"
+        "    else if (_rsx_af == 5) _rsx_pass = _rsx_a != _rsx_alpha_ref;\n"
+        "    else if (_rsx_af == 6) _rsx_pass = _rsx_a >= _rsx_alpha_ref;\n"
+        "    if (!_rsx_pass) discard;\n"
+        "    return _rsx_out;\n}\n",
+        mrt ? "PSOutput" : "float4", output, mrt ? "_rsx_out.t0" : "_rsx_out");
+    if (n < 0 || (u32)n >= sizeof(suffix))
+        return -1;
+    const size_t prefix = (size_t)(marker - hlsl);
+    if (prefix + (size_t)n + 1 > out_size)
+        return -1;
+    memcpy(marker, suffix, (size_t)n + 1);
+    return 1;
+}
+
 /* --- kept from this tree when adopting the newer decompiler ---------------
  * rsx_d3d12_backend.c calls both of these: extract_consts feeds the per-draw
  * fp_k[] slots, code_hash keys the PSO cache on the ucode rather than the
diff --git a/libs/video/rsx_fp_decompiler.h b/libs/video/rsx_fp_decompiler.h
index 71194e1..7cf0d89 100644
--- a/libs/video/rsx_fp_decompiler.h
+++ b/libs/video/rsx_fp_decompiler.h
@@ -137,6 +137,10 @@ u64 rsx_fp_literal_source_hash(
 int rsx_fp_apply_alpha_test_buffered(
     char* hlsl, u32 out_size, u32 func);
 
+/* Like the above, but the compare function is read from PSConstants too
+ * (fp_alpha.x = reference, fp_alpha.y = func - 0x200). 1 = applied. */
+int rsx_fp_apply_alpha_test_dynamic(char* hlsl, u32 out_size);
+
 /* Plan one 256-byte-aligned allocation in a fence-retired PS constant ring.
  * Returns 1 when it fits, 0 when the caller must submit/wait/reset first, and
  * -1 when one allocation can never fit. */
diff --git a/libs/video/tests/test_fp_decompiler.c b/libs/video/tests/test_fp_decompiler.c
index ba55f05..b579b61 100644
--- a/libs/video/tests/test_fp_decompiler.c
+++ b/libs/video/tests/test_fp_decompiler.c
@@ -237,6 +237,21 @@ int main(void)
         check("mrt_alpha_type", hlsl, "PSOutput _rsx_out = _out;");
         check("mrt_alpha_cmp",  hlsl, "if (!(_rsx_out.t0.a > _rsx_alpha_ref)) discard;");
 
+        /* Dynamic variant on the buffered single-target build: function and
+         * reference both come from fp_alpha, so nothing numeric is baked in. */
+        {
+            u32 nk = 0;
+            rsx_fp_decompile_buffered_ex(prog, sizeof(prog), CTRL_16BIT, 0u,
+                                         hlsl, sizeof(hlsl), &nk);
+            check_true("dyn_alpha_patched",
+                       rsx_fp_apply_alpha_test_dynamic(hlsl, sizeof(hlsl)) == 1);
+            check("dyn_alpha_cbuf", hlsl, "float4 fp_alpha;");
+            check("dyn_alpha_src",  hlsl, "const float _rsx_a = _rsx_out.a;");
+            check("dyn_alpha_func", hlsl, "const int _rsx_af = (int)(fp_alpha.y + 0.5);");
+            check("dyn_alpha_ge",   hlsl, "else if (_rsx_af == 6) _rsx_pass = _rsx_a >= _rsx_alpha_ref;");
+            check("dyn_alpha_tail", hlsl, "    if (!_rsx_pass) discard;\n    return _rsx_out;\n}\n");
+        }
+
         /* The same program under 16-bit exports: r2 is a plain temp there, so
          * the colour is h0 alone and nothing about the output changes. */
         rsx_fp_decompile(prog, sizeof(prog), CTRL_16BIT, hlsl, sizeof(hlsl));
