+/* PERF=1 extras: time blocked inside Present, inside wait_for_gpu, and inside
+ * the HLSL compiler on a shader-cache miss. "guest" in the [PERF] line is
+ * everything outside render_frame, so without these a vsync-blocked Present
+ * on the drain thread reads as slow guest code. */
+static double s_perf_present = 0.0, s_perf_gpuwait = 0.0, s_perf_fxc = 0.0;
+
+/* RSX_VSYNC=1: Present(1) blocks the frame-clock thread until vblank. That
+ * thread also drains the FIFO and writes the labels the game fences on, so a
+ * blocked Present stalls the guest too. Default 0: the flip-model swap chain
+ * shows the newest frame at the next vblank without blocking (no tearing in a
+ * window), and the 60 Hz vblank clock paces the game. */
+static UINT rsx_present_interval(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_VSYNC"); v = (e && *e) ? atoi(e) : 0;
+                 if (v < 0) v = 0; if (v > 4) v = 4; }
+    return (UINT)v;
+}
+
+/* D3DCompile with an on-disk DXBC cache (rsx_shader_cache.c). FXC costs
+ * 60-90 ms per new fragment program (PERF: pso 9-12% on the frames that
+ * missed), which is a visible hitch every time a new effect appears; with the
+ * cache that cost is paid once per shader per machine, not once per run.
+ * The key covers the full source, entry, target and flags, so any decompiler
+ * change misses naturally. RSX_FXC_FAST=1 adds D3DCOMPILE_SKIP_OPTIMIZATION
+ * (faster first compile; the GPU is ~1% of the frame). */
+static HRESULT rsx_d3dcompile(LPCVOID src, SIZE_T n, LPCSTR name,
+                              const D3D_SHADER_MACRO* defs, ID3DInclude* inc,
+                              LPCSTR entry, LPCSTR target, UINT f1, UINT f2,
+                              ID3DBlob** code, ID3DBlob** err)
+{
+    { static int fast = -1;
+      if (fast < 0) { const char* e = getenv("RSX_FXC_FAST"); fast = (e && *e == '1') ? 1 : 0; }
+      if (fast) f1 |= D3DCOMPILE_SKIP_OPTIMIZATION; }
+    if (err) *err = NULL;
+    int cacheable = code && src && n && !defs && !inc && rsx_shc_enabled();
+    uint64_t key = 0;
+    if (cacheable) {
+        key = rsx_shc_hash(RSX_SHC_HASH_INIT, src, (size_t)n);
+        key = rsx_shc_hash_str(key, entry);
+        key = rsx_shc_hash_str(key, target);
+        key = rsx_shc_hash(key, &f1, sizeof f1);
+        key = rsx_shc_hash(key, &f2, sizeof f2);
+        size_t sz = 0;
+        void* p = rsx_shc_load(key, "dxbc", &sz);
+        if (p) {
+            ID3DBlob* b = NULL;
+            if (SUCCEEDED(D3DCreateBlob(sz, &b)) && b) {
+                memcpy(b->lpVtbl->GetBufferPointer(b), p, sz);
+                free(p);
+                *code = b;
+                return S_OK;
+            }
+            free(p);
+        }
+    }
+    double t0 = perf_on() ? perf_now() : 0.0;
+    HRESULT hr = D3DCompile(src, n, name, defs, inc, entry, target, f1, f2, code, err);
+    if (perf_on()) s_perf_fxc += perf_now() - t0;
+    if (cacheable && SUCCEEDED(hr) && *code)
+        rsx_shc_store(key, "dxbc", (*code)->lpVtbl->GetBufferPointer(*code),
+                      (size_t)(*code)->lpVtbl->GetBufferSize(*code));
+    return hr;
+}
