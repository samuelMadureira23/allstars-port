diff --git a/libs/video/rsx_shader_cache.c b/libs/video/rsx_shader_cache.c
new file mode 100644
index 0000000..40c0c0f
--- /dev/null
+++ b/libs/video/rsx_shader_cache.c
@@ -0,0 +1,193 @@
+/*
+ * ps3recomp - on-disk cache of compiled GPU shader blobs (see header).
+ */
+#include "rsx_shader_cache.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#  ifndef WIN32_LEAN_AND_MEAN
+#    define WIN32_LEAN_AND_MEAN
+#  endif
+#  include <windows.h>
+#else
+#  include <sys/stat.h>
+#  include <unistd.h>
+#  include <pthread.h>
+#endif
+
+#define SHC_MAGIC   0x43585352u   /* "RSXC" little-endian */
+#define SHC_VERSION 1u
+
+typedef struct shc_header {
+    uint32_t magic;
+    uint32_t version;
+    uint64_t key;
+    uint64_t size;
+    uint64_t payload_hash;
+} shc_header;
+
+static char     s_dir[1024];
+static int      s_state = -1;          /* -1 = not initialised, 0 = off, 1 = on */
+static volatile long s_hits, s_misses, s_stores;
+
+#ifdef _WIN32
+static INIT_ONCE s_once = INIT_ONCE_STATIC_INIT;
+static long shc_inc(volatile long* p) { return InterlockedIncrement(p); }
+#else
+static pthread_once_t s_once = PTHREAD_ONCE_INIT;
+static long shc_inc(volatile long* p) { return __sync_add_and_fetch(p, 1); }
+#endif
+
+uint64_t rsx_shc_hash(uint64_t h, const void* data, size_t n)
+{
+    const unsigned char* p = (const unsigned char*)data;
+    for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 0x100000001b3ull; }
+    return h;
+}
+
+uint64_t rsx_shc_hash_str(uint64_t h, const char* s)
+{
+    if (!s) s = "";
+    return rsx_shc_hash(h, s, strlen(s) + 1);
+}
+
+static void shc_init(void)
+{
+    const char* e = getenv("RSX_SHADER_CACHE");
+    if (e && e[0] == '0') { s_state = 0; return; }
+
+    const char* d = getenv("RSX_SHADER_CACHE_DIR");
+    if (d && *d) {
+        snprintf(s_dir, sizeof s_dir, "%s", d);
+    } else {
+#ifdef _WIN32
+        char exe[MAX_PATH];
+        DWORD n = GetModuleFileNameA(NULL, exe, MAX_PATH);
+        if (n == 0 || n >= MAX_PATH) { snprintf(s_dir, sizeof s_dir, "shadercache"); }
+        else {
+            char* slash = strrchr(exe, '\\');
+            if (slash) *slash = 0; else exe[0] = 0;
+            snprintf(s_dir, sizeof s_dir, "%s%sshadercache", exe, exe[0] ? "\\" : "");
+        }
+#else
+        snprintf(s_dir, sizeof s_dir, "shadercache");
+#endif
+    }
+
+#ifdef _WIN32
+    if (!CreateDirectoryA(s_dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) {
+        fprintf(stderr, "[SHC] cannot create %s (err %lu) -- shader cache off\n",
+                s_dir, (unsigned long)GetLastError());
+        s_state = 0; return;
+    }
+#else
+    if (mkdir(s_dir, 0755) != 0) {
+        struct stat st;
+        if (stat(s_dir, &st) != 0 || !S_ISDIR(st.st_mode)) {
+            fprintf(stderr, "[SHC] cannot create %s -- shader cache off\n", s_dir);
+            s_state = 0; return;
+        }
+    }
+#endif
+    fprintf(stderr, "[SHC] shader cache: %s\n", s_dir);
+    s_state = 1;
+}
+
+#ifdef _WIN32
+static BOOL CALLBACK shc_init_cb(PINIT_ONCE o, PVOID p, PVOID* c)
+{ (void)o; (void)p; (void)c; shc_init(); return TRUE; }
+#endif
+
+int rsx_shc_enabled(void)
+{
+#ifdef _WIN32
+    InitOnceExecuteOnce(&s_once, shc_init_cb, NULL, NULL);
+#else
+    pthread_once(&s_once, shc_init);
+#endif
+    return s_state == 1;
+}
+
+static void shc_path(char* out, size_t cap, uint64_t key, const char* ext)
+{
+#ifdef _WIN32
+    const char* sep = "\\";
+#else
+    const char* sep = "/";
+#endif
+    snprintf(out, cap, "%s%s%016llx.%s", s_dir, sep, (unsigned long long)key,
+             ext ? ext : "bin");
+}
+
+void* rsx_shc_load(uint64_t key, const char* ext, size_t* out_size)
+{
+    if (out_size) *out_size = 0;
+    if (!rsx_shc_enabled()) return NULL;
+
+    char path[1200];
+    shc_path(path, sizeof path, key, ext);
+    FILE* f = fopen(path, "rb");
+    if (!f) { shc_inc(&s_misses); return NULL; }
+
+    shc_header h;
+    void* buf = NULL;
+    if (fread(&h, sizeof h, 1, f) == 1 && h.magic == SHC_MAGIC &&
+        h.version == SHC_VERSION && h.key == key && h.size > 0 &&
+        h.size < (64u << 20)) {
+        buf = malloc((size_t)h.size);
+        if (buf && (fread(buf, 1, (size_t)h.size, f) != (size_t)h.size ||
+                    rsx_shc_hash(RSX_SHC_HASH_INIT, buf, (size_t)h.size) != h.payload_hash)) {
+            free(buf);
+            buf = NULL;
+        }
+    }
+    fclose(f);
+    if (!buf) { shc_inc(&s_misses); return NULL; }
+    shc_inc(&s_hits);
+    if (out_size) *out_size = (size_t)h.size;
+    return buf;
+}
+
+int rsx_shc_store(uint64_t key, const char* ext, const void* data, size_t size)
+{
+    if (!data || size == 0 || !rsx_shc_enabled()) return -1;
+
+    char path[1200], tmp[1260];
+    shc_path(path, sizeof path, key, ext);
+    static volatile long s_tmpseq;
+    long seq = shc_inc(&s_tmpseq);
+#ifdef _WIN32
+    snprintf(tmp, sizeof tmp, "%s.%lu.%ld.tmp", path, (unsigned long)GetCurrentProcessId(), seq);
+#else
+    snprintf(tmp, sizeof tmp, "%s.%ld.%ld.tmp", path, (long)getpid(), seq);
+#endif
+
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return -1;
+    shc_header h;
+    h.magic = SHC_MAGIC;
+    h.version = SHC_VERSION;
+    h.key = key;
+    h.size = size;
+    h.payload_hash = rsx_shc_hash(RSX_SHC_HASH_INIT, data, size);
+    int ok = fwrite(&h, sizeof h, 1, f) == 1 && fwrite(data, 1, size, f) == size;
+    ok = (fclose(f) == 0) && ok;
+    if (!ok) { remove(tmp); return -1; }
+#ifdef _WIN32
+    if (!MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) { DeleteFileA(tmp); return -1; }
+#else
+    if (rename(tmp, path) != 0) { remove(tmp); return -1; }
+#endif
+    shc_inc(&s_stores);
+    return 0;
+}
+
+void rsx_shc_stats(unsigned* hits, unsigned* misses, unsigned* stores)
+{
+    if (hits)   *hits   = (unsigned)s_hits;
+    if (misses) *misses = (unsigned)s_misses;
+    if (stores) *stores = (unsigned)s_stores;
+}
diff --git a/libs/video/rsx_shader_cache.h b/libs/video/rsx_shader_cache.h
new file mode 100644
index 0000000..7536c0d
--- /dev/null
+++ b/libs/video/rsx_shader_cache.h
@@ -0,0 +1,53 @@
+/*
+ * ps3recomp - on-disk cache of compiled GPU shader blobs
+ *
+ * Backend-agnostic: the D3D12 backend stores DXBC from D3DCompile here, a
+ * Vulkan backend can store SPIR-V the same way. The key is a 64-bit hash of
+ * everything that determines the compiled output (source text, entry point,
+ * target profile, compile flags, a format version); a decompiler change
+ * produces new source text and therefore new keys, so the cache never needs
+ * manual invalidation.
+ *
+ * Each entry is one file <dir>/<key:016llx>.<ext> with a small header
+ * (magic, version, payload size, payload hash). A truncated or corrupt
+ * entry reads as a miss and is overwritten by the next store. Writes go to a
+ * temporary name first and are then renamed, so a crash mid-write never
+ * leaves a half entry under the real name.
+ *
+ * Env: RSX_SHADER_CACHE=0 disables it; RSX_SHADER_CACHE_DIR overrides the
+ * directory (default: "shadercache" next to the executable).
+ */
+#ifndef PS3RECOMP_RSX_SHADER_CACHE_H
+#define PS3RECOMP_RSX_SHADER_CACHE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* FNV-1a 64 over a byte range, chainable: pass the previous result as h
+ * (start with RSX_SHC_HASH_INIT). */
+#define RSX_SHC_HASH_INIT 0xcbf29ce484222325ull
+uint64_t rsx_shc_hash(uint64_t h, const void* data, size_t n);
+uint64_t rsx_shc_hash_str(uint64_t h, const char* s);   /* includes the NUL */
+
+/* 1 when the cache is usable (enabled and the directory exists or could be
+ * created). Initialises lazily on first call; thread-safe. */
+int rsx_shc_enabled(void);
+
+/* Look up a key. On a hit returns a malloc'd copy of the payload (caller
+ * frees) and its size in *out_size; on a miss returns NULL. */
+void* rsx_shc_load(uint64_t key, const char* ext, size_t* out_size);
+
+/* Store a payload under a key. Returns 0 on success. */
+int rsx_shc_store(uint64_t key, const char* ext, const void* data, size_t size);
+
+/* Counters for the [PERF] line. */
+void rsx_shc_stats(unsigned* hits, unsigned* misses, unsigned* stores);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/tests/test_shader_cache.c b/libs/video/tests/test_shader_cache.c
new file mode 100644
index 0000000..94bb6d3
--- /dev/null
+++ b/libs/video/tests/test_shader_cache.c
@@ -0,0 +1,61 @@
+/*
+ * Unit test for rsx_shader_cache.c: miss, store, hit, corrupt and truncated
+ * entries read as misses, and the extension is part of the entry name.
+ *
+ *   cc -I libs/video libs/video/tests/test_shader_cache.c libs/video/rsx_shader_cache.c -lpthread
+ *   ./a.out <empty-scratch-dir>
+ */
+#include "rsx_shader_cache.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); return 1; } } while (0)
+
+int main(int argc, char** argv)
+{
+    const char* dir = argc > 1 ? argv[1] : "shc_test";
+#ifdef _WIN32
+    _putenv_s("RSX_SHADER_CACHE_DIR", dir);
+    const char sep = '\\';
+#else
+    setenv("RSX_SHADER_CACHE_DIR", dir, 1);
+    const char sep = '/';
+#endif
+    CHECK(rsx_shc_enabled());
+
+    uint64_t k = rsx_shc_hash_str(RSX_SHC_HASH_INIT, "float4 main() : SV_Target { return 1; }");
+    k = rsx_shc_hash_str(k, "ps_5_0");
+    size_t n = 0;
+    CHECK(rsx_shc_load(k, "dxbc", &n) == NULL);
+
+    const char blob[] = "DXBC-fake-payload-1234567890";
+    CHECK(rsx_shc_store(k, "dxbc", blob, sizeof blob) == 0);
+    void* p = rsx_shc_load(k, "dxbc", &n);
+    CHECK(p && n == sizeof blob && memcmp(p, blob, n) == 0);
+    free(p);
+
+    char path[1024];
+    snprintf(path, sizeof path, "%s%c%016llx.dxbc", dir, sep, (unsigned long long)k);
+    FILE* f = fopen(path, "r+b");
+    CHECK(f);
+    fseek(f, -3, SEEK_END); fputc('X', f); fclose(f);
+    CHECK(rsx_shc_load(k, "dxbc", &n) == NULL);          /* corrupt payload */
+
+    f = fopen(path, "wb"); CHECK(f); fwrite("RSXC", 1, 4, f); fclose(f);
+    CHECK(rsx_shc_load(k, "dxbc", &n) == NULL);          /* truncated header */
+
+    CHECK(rsx_shc_load(k, "spv", &n) == NULL);           /* other extension */
+
+    CHECK(rsx_shc_store(k, "dxbc", blob, sizeof blob) == 0);   /* overwrite repairs */
+    p = rsx_shc_load(k, "dxbc", &n);
+    CHECK(p && n == sizeof blob);
+    free(p);
+
+    unsigned h, m, s;
+    rsx_shc_stats(&h, &m, &s);
+    CHECK(h == 2 && m == 4 && s == 2);
+    printf("test_shader_cache: OK\n");
+    return 0;
+}
