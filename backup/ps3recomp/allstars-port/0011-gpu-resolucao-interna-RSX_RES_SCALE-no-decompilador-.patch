From b5fe3336611a5fd9bdcd2862e57a7c164aa5f97a Mon Sep 17 00:00:00 2001
From: samuel <samuel.madureira23@gmail.com>
Date: Wed, 14 Oct 2026 14:25:38 -0300
Subject: [PATCH 11/12] gpu: resolucao interna RSX_RES_SCALE no decompilador de
 FP (WPOS dividido pela escala) (T-021)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/video/rsx_fp_decompiler.c        | 14 +++++++++++++-
 libs/video/rsx_fp_decompiler.h        |  4 ++++
 libs/video/tests/test_fp_decompiler.c | 18 ++++++++++++++++++
 3 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/libs/video/rsx_fp_decompiler.c b/libs/video/rsx_fp_decompiler.c
index 2fe5dea..94ca4de 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -329,13 +329,25 @@ static void decode_src(u32 w, int abs_bit, Src* s)
 /* HLSL expression for the interpolated input selected by OPDEST.INPUT_SRC.
  * The backend's passthrough VS forwards COL0/COL1/FOG/TEXCOORD0..7; WPOS maps
  * to SV_POSITION (screen-space — an approximation of the RSX window coord). */
+/* WPOS under an internal resolution multiplier (RSX_RES_SCALE): the host
+ * rasterises RS x the guest's pixels, so SV_POSITION.xy is divided back to guest
+ * window units. At 1 the expression is the bare input and every program is
+ * byte-identical to before. */
+static char s_wpos_expr[96] = "input.position";
+void rsx_fp_set_wpos_scale(float s)
+{
+    if (!(s > 1.0f)) { snprintf(s_wpos_expr, sizeof s_wpos_expr, "input.position"); return; }
+    snprintf(s_wpos_expr, sizeof s_wpos_expr, "(input.position * float4(%.9g, %.9g, 1, 1))",
+             1.0 / (double)s, 1.0 / (double)s);
+}
+
 static const char* input_expr(u32 input_src)
 {
     static const char* tc[8] = {
         "input.tc0", "input.tc1", "input.tc2", "input.tc3",
         "input.tc4", "input.tc5", "input.tc6", "input.tc7" };
     switch (input_src) {
-    case 0x0: return "input.position"; /* WPOS */
+    case 0x0: return s_wpos_expr;      /* WPOS */
     case 0x1: return "input.col0";     /* COL0 */
     case 0x2: return "input.col1";     /* COL1 */
     case 0x3: return "input.fog";      /* FOGC */
diff --git a/libs/video/rsx_fp_decompiler.h b/libs/video/rsx_fp_decompiler.h
index cbec250..71194e1 100644
--- a/libs/video/rsx_fp_decompiler.h
+++ b/libs/video/rsx_fp_decompiler.h
@@ -168,4 +168,8 @@ u32 rsx_fp_program_size(const u8* ucode, u32 max_bytes);
 /* Kept from this tree (see the .c) -- used by rsx_d3d12_backend.c. */
 int rsx_fp_extract_consts(const u8* ucode, u32 max_bytes, float* out, int max_out);
 u32 rsx_fp_code_hash(const u8* ucode, u32 max_bytes);
+
+/* Internal resolution multiplier for WPOS reads (1 = unchanged output). Set
+ * once at backend init, before any program is decompiled. */
+void rsx_fp_set_wpos_scale(float s);
 #endif /* PS3RECOMP_RSX_FP_DECOMPILER_H */
diff --git a/libs/video/tests/test_fp_decompiler.c b/libs/video/tests/test_fp_decompiler.c
index 44cf26a..ba55f05 100644
--- a/libs/video/tests/test_fp_decompiler.c
+++ b/libs/video/tests/test_fp_decompiler.c
@@ -106,6 +106,24 @@ int main(void)
                                   "    return (_o == _o) ? _o : (float4)0;\n}\n");
     }
 
+    /* Test 1b: MOV r0, WPOS -- divided back to guest pixels under an
+     * internal resolution multiplier, untouched at 1. */
+    {
+        u8 prog[16];
+        put_word(prog + 0, OPC(0x01) | OUTMASK_ALL | INSRC(0) | END); /* MOV, WPOS */
+        put_word(prog + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8, 0);
+        put_word(prog + 12, 0);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check("wpos_plain", hlsl, "(input.position).xyzw");
+        rsx_fp_set_wpos_scale(2.0f);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check("wpos_scaled", hlsl, "((input.position * float4(0.5, 0.5, 1, 1))).xyzw");
+        rsx_fp_set_wpos_scale(1.0f);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check_absent("wpos_reset", hlsl, "float4(0.5, 0.5, 1, 1)");
+    }
+
     /* Test 2: MUL r1.xy, r0, r0  (partial write mask). */
     {
         u8 prog[16];
-- 
