diff --git a/runtime/spu/tests/test_interp_fallback_main.c b/runtime/spu/tests/test_interp_fallback_main.c
new file mode 100644
index 0000000..256c885
--- /dev/null
+++ b/runtime/spu/tests/test_interp_fallback_main.c
@@ -0,0 +1,81 @@
+/* Interpreter fallback (spu_interp_call.c) against the REAL drain machinery
+ * (spu_drain.c) and the REAL interpreter. See gen_test_interp_fallback.py.
+ *
+ * The registry below deliberately omits B (0x40) and B2 (0x60): lifted main
+ * reaches them through bisl, misses, and the fallback must interpret them,
+ * run the lifted callee C from inside B as a nested call, hand B2's tail jump
+ * to C2 to the trampoline, and come back to main both times. */
+#include "spu_recomp.h"
+#include "spu_helpers.h"
+#include "spu_interp.h"
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include <stdlib.h>
+
+uint8_t* vm_base = 0;
+int g_cri_video_dma = 0;
+static uint32_t g_out; static int g_wrote;
+
+u128 spu_rdch(spu_context* ctx, uint32_t ch) { (void)ctx; (void)ch; return spu_zero(); }
+uint32_t spu_rchcnt(spu_context* ctx, uint32_t ch) { (void)ctx; (void)ch; return 1; }
+void spu_wrch(spu_context* ctx, uint32_t channel, u128 value) {
+    (void)ctx;
+    if (channel == SPU_WrOutMbox) { g_out = value._u32[0]; g_wrote = 1; }
+}
+void spu_register_function(uint32_t addr, void (*fn)(spu_context*)) { (void)addr; (void)fn; }
+void spu_stop(spu_context* ctx) { (void)ctx; }
+void spu_halt(spu_context* ctx) { printf("FAIL: halt at 0x%05X\n", ctx->pc); exit(1); }
+void yz_lockstep_tick(spu_context* ctx) { (void)ctx; }
+void spu_check_stack_reset(spu_context* ctx, void* fn) { (void)ctx; (void)fn; }
+void spu_restart_dispatch(spu_context* ctx) {
+    printf("FAIL: drain restarted dispatch at pc=0x%05X\n", ctx->pc); exit(1);
+}
+void spu_spurs_taskset_syscall(spu_context* ctx) { (void)ctx; }
+int g_wws_read_probe, g_wws_code_probe;
+
+typedef void (*fn_t)(spu_context*);
+fn_t spu_lookup(uint32_t addr, int image_id) {
+    (void)image_id;
+    switch (addr) {                      /* B (0x40) and B2 (0x60): not lifted */
+    case 0x00: return spu_func_00000000;
+    case 0x80: return spu_func_00000080;
+    case 0x90: return spu_func_00000090;
+    default:   return 0;
+    }
+}
+spu_lifted_fn spu_lifted_lookup(const spu_context* ctx, uint32_t lsa) {
+    return (spu_lifted_fn)spu_lookup(lsa, ctx ? ctx->image_id : 0);
+}
+
+/* The two lines of spu_indirect_branch this test is about: a hit runs the
+ * lifted function, a miss on real code goes to the fallback. */
+int spu_interp_call(spu_context* ctx, uint32_t target, uint32_t ret_pc);
+static int g_misses;
+void spu_indirect_branch(spu_context* ctx) {
+    ctx->pc &= SPU_LS_MASK;
+    fn_t fn = spu_lookup(ctx->pc, ctx->image_id);
+    if (fn) { fn(ctx); return; }
+    g_misses++;
+    spu_interp_call(ctx, ctx->pc, ctx->gpr[0]._u32[0]);
+}
+
+int main(void) {
+    static spu_context ctx;
+    spu_context_init(&ctx, 0);
+    FILE* f = fopen("test_interp_fallback.bin", "rb");
+    if (!f) { printf("FAIL: no test_interp_fallback.bin\n"); return 1; }
+    size_t n = fread(ctx.ls, 1, SPU_LS_SIZE, f); fclose(f);
+    if (n == 0) { printf("FAIL: empty image\n"); return 1; }
+    ctx.gpr[1]._u32[0] = 0x3FF00;            /* stack */
+
+    spu_func_00000000(&ctx);
+
+    if (!g_wrote)       { printf("FAIL: main never reached its wrch\n"); return 1; }
