diff --git a/runtime/spu/spu_interp_call.c b/runtime/spu/spu_interp_call.c
new file mode 100644
index 0000000..81ebea0
--- /dev/null
+++ b/runtime/spu/spu_interp_call.c
@@ -0,0 +1,186 @@
+/* spu_interp_call.c -- interpreter fallback for SPU code the static lift missed.
+ *
+ * The lifter only finds functions it can see statically. Code reached solely
+ * through a pointer built at runtime -- C++ vtables assembled in local store,
+ * callback tables, the WWS/SPURS service hooks -- is invisible to it, and a
+ * call into it used to end the whole SPU program: spu_indirect_branch found no
+ * lifted function, logged "BRANCH-TO-0 unresolved" and halted. A task that
+ * dies in the middle leaves whatever it was publishing half-done, which is how
+ * All-Stars froze after START (T-017: spu_0001's virtual method 0x4DC0 was
+ * never lifted, so the task skipped its second atomic increment and the PPU
+ * waited forever on the handle).
+ *
+ * This file makes that miss survivable and still exactly right: interpret the
+ * missing code from live local store with the SAME helpers the lifter emits,
+ * and give control back to lifted code at the boundaries the lifted code
+ * itself uses.
+ *
+ *   - Return. The interpreted function was entered through a lifted call
+ *     bracket (bisl -> host_depth++ -> spu_indirect_branch -> spu_drain_call
+ *     (ret)). When the guest branches back to the link it was entered with,
+ *     stop with ctx->pc = that link and no trampoline pending; the bracket's
+ *     spu_drain_call sees pc == return_pc and the lifted caller continues.
+ *
+ *   - Calls OUT of interpreted code (brsl/brasl/bisl) are run as real nested
+ *     calls through spu_indirect_branch inside the same host_depth/drain
+ *     bracket the lifter emits. A lifted callee runs compiled; an unlifted one
+ *     recurses into this fallback with its own return address. Either way the
+ *     interpreted caller continues at pc+4 afterwards. (spu_interp_run gets
+ *     this wrong: it stops at the first lifted address it reaches, so a call
+ *     from interpreted code into a lifted function abandoned the rest of the
+ *     interpreted caller.)
+ *
+ *   - Any other transfer onto a lifted entry (a tail jump, a fall-through
+ *     into the next lifted function) is handed to the trampoline exactly like
+ *     a lifted cross-function branch, and the enclosing drain runs it.
+ *
+ * Every first miss per (image, address) is logged once: the fallback is a
+ * safety net, the fix for speed is still to add the address to the image's
+ * extra-functions list and relift. SPU_INTERP_MISSLOG=<file> appends the
+ * misses as "image lsa" lines for that.
+ *
+ * SPU_INTERP_FALLBACK=0 restores the old halt-on-miss behaviour.
+ */
+#include "spu_interp.h"
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef void (*spu_fn)(spu_context*);
+spu_fn spu_lookup(uint32_t addr, int image_id);   /* spu_channels.c */
+int    spu_interp_step(spu_context* ctx);         /* spu_interp.c: one insn, 1 = stopped */
+void   spu_stop(spu_context* ctx);
+void   spu_halt(spu_context* ctx);
+
+int spu_interp_fallback_enabled(void)
+{
+    static int s_on = -1;
+    if (s_on < 0) {
+        const char* e = getenv("SPU_INTERP_FALLBACK");
+        s_on = (e && e[0] == '0') ? 0 : 1;
+    }
+    return s_on;
+}
+
+/* Same resolution order as spu_indirect_branch: a resident task or overlay
+ * owns its LS range, the base image comes last. */
+static spu_fn spu_ifb_resolve(const spu_context* ctx, uint32_t pc)
+{
+    spu_fn fn = 0;
+    for (unsigned slot = 0; slot < 4; ++slot) {
+        if (ctx->resident_code[slot].image_id && pc >= ctx->resident_code[slot].lsa &&
+            pc - ctx->resident_code[slot].lsa < ctx->resident_code[slot].size)
+            return spu_lookup(pc, ctx->resident_code[slot].image_id);
+    }
+    if (ctx->resident_task) fn = spu_lookup(pc, ctx->resident_task);
+    if (!fn && ctx->resident_ovl) fn = spu_lookup(pc, ctx->resident_ovl);
+    if (!fn) fn = spu_lookup(pc, ctx->image_id);
+    return fn;
+}
+
+static uint32_t spu_ifb_fetch(const spu_context* ctx, uint32_t pc)
+{
+    const uint8_t* p = ctx->ls + (pc & SPU_LS_MASK & ~3u);
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+static void spu_ifb_note_miss(const spu_context* ctx, uint32_t pc, uint32_t ret)
+{
+    enum { SEEN = 256 };
+    static struct { int img; uint32_t pc; } seen[SEEN];
+    static unsigned n_seen;
+    for (unsigned i = 0; i < n_seen && i < SEEN; i++)
+        if (seen[i].img == ctx->image_id && seen[i].pc == pc) return;
+    if (n_seen < SEEN) { seen[n_seen].img = ctx->image_id; seen[n_seen].pc = pc; }
+    n_seen++;
+    fprintf(stderr, "[spu-ifb] img=%d interpreting unlifted SPU code at LS 0x%05X "
+            "(return 0x%05X) -- add it to the image's extra functions and relift\n",
+            ctx->image_id, pc, ret & SPU_LS_MASK);
+    fflush(stderr);
+    const char* path = getenv("SPU_INTERP_MISSLOG");
+    if (path && *path) {
+        FILE* f = fopen(path, "a");
+        if (f) { fprintf(f, "%d 0x%05X\n", ctx->image_id, pc); fclose(f); }
+    }
+}
+
+/* Is `insn` a call (sets a link and transfers)? Returns the link register
+ * number and the target, or -1. brsl/brasl are RI16 (9-bit opcode), bisl is
+ * RR (11-bit opcode). bisled is NOT treated as a call here: it only branches
+ * when an event is pending, which spu_interp_step already models. */
+static int spu_ifb_call(const spu_context* ctx, uint32_t insn, uint32_t pc, uint32_t* tgt)
+{
+    uint32_t op9 = insn >> 23, op11 = insn >> 21;
+    int32_t  i16 = (int32_t)(int16_t)((insn >> 7) & 0xFFFF);
+    if (op9 == 0x066) {                          /* brsl rt, rel */
+        *tgt = ((uint32_t)(i16 * 4) + pc) & 0x3FFFC;
+        return (int)(insn & 0x7F);
+    }
+    if (op9 == 0x062) {                          /* brasl rt, abs */
+        *tgt = ((uint32_t)(i16 * 4)) & 0x3FFFC;
+        return (int)(insn & 0x7F);
+    }
+    if (op11 == 0x1A9) {                         /* bisl rt, ra */
+        *tgt = ctx->gpr[(insn >> 7) & 0x7F]._u32[0] & 0x3FFFC;
+        return (int)(insn & 0x7F);
+    }
+    return -1;
+}
+
+int spu_interp_call(spu_context* ctx, uint32_t target, uint32_t ret_pc)
+{
+    uint32_t pc = target & 0x3FFFC;
+    ret_pc &= 0x3FFFC;
+    spu_ifb_note_miss(ctx, pc, ret_pc);
+    ctx->pc = pc;
+    g_spu_trampoline_fn = 0;
+
+    for (uint64_t steps = 0;; steps++) {
+        pc = ctx->pc & 0x3FFFC;
+        ctx->pc = pc;
+        if (steps) {
+            /* Back at the link the lifted caller is draining for. */
+            if (pc == ret_pc)
+                return 1;
+            /* Onto compiled code by a non-call transfer: hand it to the
+             * trampoline, as a lifted cross-function branch would. */
+            if (spu_ifb_resolve(ctx, pc)) {
+                g_spu_trampoline_fn = spu_indirect_branch;
+                return 0;
+            }
+        }
+        uint32_t insn = spu_ifb_fetch(ctx, pc);
+        uint32_t tgt = 0;
+        int link = spu_ifb_call(ctx, insn, pc, &tgt);
+        if (link >= 0 && tgt != pc && tgt != pc + 4) {
+            /* A real call: same bracket the lifter emits for brsl/bisl. The
+             * self-call trap (tgt == pc) and the pc-getter idiom (tgt == pc+4)
+             * fall to spu_interp_step, which handles them as plain branches. */
+            ctx->gpr[link] = spu_link(pc + 4);
+            if (insn & 0x40000)      ctx->int_enable = 1;   /* bisle */
+            else if (insn & 0x80000) ctx->int_enable = 0;   /* bisld */
+            int32_t si = (int32_t)ctx->image_id;
+            ctx->pc = tgt;
+            ctx->host_depth++;
+            spu_indirect_branch(ctx);
+            spu_drain_call(ctx, pc + 4);
+            ctx->host_depth--;
+            spu_img_restore(ctx, si);
+            ctx->pc = pc + 4;
+            continue;
+        }
+        if (spu_interp_step(ctx)) {
+            if (ctx->status & SPU_STATUS_STOPPED_BY_HALT) {
+                /* heq-family assert or an opcode the interpreter cannot run:
+                 * stop the SPU like the lifted halt does. */
+                fprintf(stderr, "[spu-ifb] img=%d halt at LS 0x%05X\n",
+                        ctx->image_id, ctx->pc & SPU_LS_MASK);
+                spu_halt(ctx);
+                return -1;
+            }
+            /* stop/stopd: the lifted form is status + spu_stop + return. */
+            spu_stop(ctx);
+            return -1;
+        }
+    }
+}
diff --git a/runtime/spu/tests/gen_test_interp_fallback.py b/runtime/spu/tests/gen_test_interp_fallback.py
new file mode 100644
index 0000000..9822b66
--- /dev/null
+++ b/runtime/spu/tests/gen_test_interp_fallback.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Interpreter fallback: lifted code calls SPU functions the lift never saw.
+
+main (lifted) reaches B and B2 only through a pointer in a register (the
+vtable shape that broke All-Stars, T-017), so they are deliberately left out
+of the symbol list and have no lifted body:
+
+    main: il r3,1 ; ila r2,B  ; bisl r0,r2      B: r3+=10, brsl C (lifted), return
+          ila r2,B2 ; bisl r0,r2                B2: r3+=5, tail-jump to C2 (lifted)
+          wrch OutMbox,r3 ; stop                C:  r3 <<= 1 ; bi r0
+                                                C2: r3 += 100 ; bi r0
+
+Expected mailbox value: ((1 + 10) << 1) + 5 + 100 = 127.
+Also writes the raw image (test_interp_fallback.bin) for the harness to
+load into local store, since the interpreter executes live LS bytes.
+"""
+import struct, os, sys
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "..", "..", "tools"))
+from wrap_spu_elf import wrap
+
+def w(v): return struct.pack(">I", v & 0xFFFFFFFF)
+def ri16(op9, i16, rt): return w(((op9 & 0x1FF) << 23) | ((i16 & 0xFFFF) << 7) | (rt & 0x7F))
+def ri18(op7, i18, rt): return w(((op7 & 0x7F) << 25) | ((i18 & 0x3FFFF) << 7) | (rt & 0x7F))
+def ri10(op8, i10, ra, rt): return w(((op8 & 0xFF) << 24) | ((i10 & 0x3FF) << 14) | ((ra & 0x7F) << 7) | (rt & 0x7F))
+def ri7(op11, i7, ra, rt): return w(((op11 & 0x7FF) << 21) | ((i7 & 0x7F) << 14) | ((ra & 0x7F) << 7) | (rt & 0x7F))
+def rr(op11, rb, ra, rt): return w(((op11 & 0x7FF) << 21) | ((rb & 0x7F) << 14) | ((ra & 0x7F) << 7) | (rt & 0x7F))
+def ch(op11, channel, rt): return w(((op11 & 0x7FF) << 21) | ((channel & 0x7F) << 7) | (rt & 0x7F))
+
+IL, ILA, AI, STQD, LQD, SHLI = 0x081, 0x21, 0x1C, 0x24, 0x34, 0x07B
+BR, BRSL, BI, BISL, WRCH = 0x064, 0x066, 0x1A8, 0x1A9, 0x10D
+
+img = bytearray(0xA0)
+def put(addr, words):
+    for i, x in enumerate(words):
+        img[addr + 4*i: addr + 4*i + 4] = x
+
+put(0x00, [ri16(IL, 1, 3),                 # 0x00 il   r3, 1
+           ri18(ILA, 0x40, 2),             # 0x04 ila  r2, B
+           rr(BISL, 0, 2, 0),              # 0x08 bisl r0, r2
+           ri18(ILA, 0x60, 2),             # 0x0C ila  r2, B2
+           rr(BISL, 0, 2, 0),              # 0x10 bisl r0, r2
+           ch(WRCH, 28, 3),                # 0x14 wrch SPU_WrOutMbox, r3
+           rr(0x000, 0, 0, 0)])            # 0x18 stop
+put(0x40, [ri10(STQD, 1, 1, 0),            # 0x40 stqd r0, 16(r1)
+           ri10(AI, -32, 1, 1),            # 0x44 ai   r1, r1, -32
+           ri10(AI, 10, 3, 3),             # 0x48 ai   r3, r3, 10
+           ri16(BRSL, (0x80 - 0x4C)//4, 0),# 0x4C brsl r0, C
+           ri10(AI, 32, 1, 1),             # 0x50 ai   r1, r1, 32
+           ri10(LQD, 1, 1, 0),             # 0x54 lqd  r0, 16(r1)
+           rr(BI, 0, 0, 0)])               # 0x58 bi   r0
+put(0x60, [ri10(AI, 5, 3, 3),              # 0x60 ai   r3, r3, 5
+           ri16(BR, (0x90 - 0x64)//4, 0)]) # 0x64 br   C2  (tail jump)
+put(0x80, [ri7(SHLI, 1, 3, 3),             # 0x80 shli r3, r3, 1
+           rr(BI, 0, 0, 0)])               # 0x84 bi   r0
+put(0x90, [ri10(AI, 100, 3, 3),            # 0x90 ai   r3, r3, 100
+           rr(BI, 0, 0, 0)])               # 0x94 bi   r0
+
+elf = wrap(bytes(img), base=0, entry=0,
+           symbols=[{"name": "main", "addr": 0x00, "size": 0x1C},
+                    {"name": "C",    "addr": 0x80, "size": 0x08},
+                    {"name": "C2",   "addr": 0x90, "size": 0x08}])
+open(os.path.join(HERE, "test_interp_fallback.elf"), "wb").write(elf)
+open(os.path.join(HERE, "test_interp_fallback.bin"), "wb").write(bytes(img))
+print(f"Wrote test_interp_fallback.elf ({len(img)} bytes)")
