 #ifdef _WIN32
     if (_stat64(host_path, (struct _stat64*)&st) != 0)
@@ -670,6 +676,8 @@ int64_t sys_fs_stat(ppu_context* ctx)
     if (stat(host_path, &st) != 0)
 #endif
     {
+        { extern char* getenv(const char*); if (getenv("PS3_SYSFSLOG")) {
