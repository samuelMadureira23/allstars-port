@@ -874,6 +882,9 @@ int64_t sys_fs_mkdir(ppu_context* ctx)
     char host_path[1024];
     sys_fs_translate_path(ps3_path, host_path, sizeof(host_path));
 
+    { extern char* getenv(const char*); if (getenv("PS3_SYSFSLOG")) {
