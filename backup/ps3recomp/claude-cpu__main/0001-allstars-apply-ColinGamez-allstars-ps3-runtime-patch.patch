 libs/system/cellSysutil.c     |  5 +++-
 libs/system/sysPrxForUser.c   |  5 ++++
 runtime/ppu/ppu_loader.cpp    |  2 +-
 runtime/ppu/ppu_sysprx.cpp    | 36 +++++++++++++++++++++-------
 runtime/syscalls/sys_fs.c     | 11 +++++++++
 runtime/syscalls/sys_rwlock.c |  5 ++++
 7 files changed, 99 insertions(+), 10 deletions(-)

