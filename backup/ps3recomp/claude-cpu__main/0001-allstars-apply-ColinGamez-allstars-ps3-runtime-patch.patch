diff --git a/runtime/ppu/ppu_sysprx.cpp b/runtime/ppu/ppu_sysprx.cpp
index bafd35e..ca5d473 100644
--- a/runtime/ppu/ppu_sysprx.cpp
+++ b/runtime/ppu/ppu_sysprx.cpp
@@ -152,7 +152,8 @@ static struct LwmSlot { volatile long addr; HANDLE sem;
     volatile unsigned long long acq_cpu_us; } g_lwm[LWM_HASH];
 extern "C" { extern volatile long long g_gcm_ref_pub_count;    /* cellGcmSys.c */
              unsigned long long ppu_thread_cpu_us(unsigned tid);   /* sys_ppu_thread.c */
-             unsigned ppu_thread_prof_pc(unsigned tid); }
+             unsigned ppu_thread_prof_pc(unsigned tid);
+             void ydkj_release_pending_threads(void); }            /* sys_ppu_thread.c */
 static volatile long g_lwm_tab_lock = 0;
 /* PS3_LWMUTEX_TRACE=1: reconstruct the lwmutex lock-convoy that stalls LBP's loader.
  * Records, per mutex, the acquiring tid + a QPC microsecond timestamp; on a
@@ -232,13 +233,29 @@ static void sys_lwmutex_lock(ppu_context* ctx)
             return;
         }
         if (WaitForSingleObject(s, 0) != WAIT_OBJECT_0) {
+            /* PPU_THREADGATE extension: PS3 priority semantics 窶・gated workers
+             * (created suspended) run only after the creator blocks. The gate
+             * previously released solely on event-queue waits, but titles like
+             * All-Stars block first on lwmutex (FIOS startup), stranding gated
+             * workers suspended forever. Release on the CREATOR's (tid 1)
+             * first contention-block: by then its init burst (worker struct
+             * fills) is done. Workers blocking first do NOT release. */
+            if ((unsigned long long)ctx->thread_id == 1ull) {
+                ydkj_release_pending_threads();
+            }
             /* Contended: log who we're stuck behind (owner stamped at acquire),
              * then block. Bounded diagnostics for park hunts; uncapped while the
              * probe window is open (g_nd_inpump). */
             static long _bl = 0; long _b = ++_bl;
-            if (g_nd_inpump || _b <= 40) fprintf(stderr, "[LWM-BLOCK] tid=%llu lwm=0x%08X owner=%u recur=%u tmo=%lluus\n",
+            if (g_nd_inpump || _b <= 40) fprintf(stderr, "[LWM-BLOCK] tid=%llu lwm=0x%08X owner=%u recur=%u tmo=%lluus cia=0x%08X lr=0x%08X\n",
                 (unsigned long long)ctx->thread_id, lwm, vm_read32(lwm + LWM_OWNER), vm_read32(lwm + LWM_RECUR),
-                (unsigned long long)timeout_us);
+                (unsigned long long)timeout_us, (uint32_t)ctx->cia, (uint32_t)ctx->lr);
+            { extern char* getenv(const char*); if (getenv("PS3_LWMEMDUMP")) {
+                char mb[1024]; int mp = 0;
+                mp += snprintf(mb + mp, sizeof(mb) - mp, "[LWM-MEM] lwm=0x%08X:", lwm);
+                for (int wo = -8; wo <= 8 && mp < 900; wo++)
+                    mp += snprintf(mb + mp, sizeof(mb) - mp, " %+d:0x%08X", wo * 4, vm_read32(lwm + wo * 4));
+                fprintf(stderr, "%s\n", mb); fflush(stderr); } }
             if (lwm_trace()) { struct LwmSlot* sl = lwm_find(lwm);
                 long h = sl ? sl->holder : 0; long long held = (sl && h) ? (lwm_now_us() - sl->acq_us) : 0;
                 fprintf(stderr, "[LWM-CONVOY] tid=%llu BLOCKs lwm=0x%08X -> held-by-tid=%ld for %lldus (guest-owner=%u)\n",
@@ -338,15 +355,18 @@ static void sys_lwmutex_unlock(ppu_context* ctx)
  * EAs (the generic adapter would pass them raw and the C sysPrxForUser impl
  * deref'd them as host pointers -> AV during cellSpurs init). A no-op wait is
  * adequate here: the CRT/SPURS paths that reach us use these for one-shot init
- * handshakes, not long-term blocking. sys_lwcond_t: +0x00 lwmutex EA (be64),
- * +0x08 lwcond_queue id. */
+ * handshakes, not long-term blocking. sys_lwcond_t is 8 bytes (guest pointers
+ * are 32-bit): +0x00 lwmutex EA (be32), +0x04 lwcond_queue id (be32) -- same
+ * layout as sys_lwcond_t_hle. Writing a be64 at +0 left the lwmutex word zero
+ * and spilled the id past the struct; games that embed the lwcond (FIOS keeps it
+ * at cond+0x10 and treats a zero first word as "invalid cond") never woke. */
 static void sys_lwcond_create(ppu_context* ctx)
 {
     static uint32_t s_lwcond_id = 0x4C000000u;
     uint32_t lwcond  = (uint32_t)ctx->gpr[3];
     uint32_t lwmutex = (uint32_t)ctx->gpr[4];
-    vm_write64(lwcond + 0x00, (uint64_t)lwmutex);
-    vm_write32(lwcond + 0x08, ++s_lwcond_id);
+    vm_write32(lwcond + 0x00, lwmutex);
+    vm_write32(lwcond + 0x04, ++s_lwcond_id);
     ctx->gpr[3] = 0;
 }
 static void sys_lwcond_destroy(ppu_context* ctx)    { ctx->gpr[3] = 0; }
@@ -360,7 +380,7 @@ static void sys_lwcond_signal_to(ppu_context* ctx)  { ctx->gpr[3] = 0; }
 static void sys_lwcond_wait(ppu_context* ctx)
 {
     uint32_t lwcond  = (uint32_t)ctx->gpr[3];
-    uint32_t lwmutex = (uint32_t)vm_read64(lwcond + 0x00);
+    uint32_t lwmutex = vm_read32(lwcond + 0x00);
 #ifdef _WIN32
     HANDLE s = lwm_sem(lwmutex);
     if (s) {
