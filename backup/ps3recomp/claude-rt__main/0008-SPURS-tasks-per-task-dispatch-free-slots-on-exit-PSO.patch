         /* Persistent LS is retained in its taskset slot for the next task; a
@@ -1025,8 +1042,34 @@ int spu_taskset_wait_signal(uint32_t taskset_ea, uint32_t taskId)
     return 0;
 }
 
+static int dispatch_async_impl(const uint8_t* image, uint32_t image_size,
+                               uint32_t args_ea, int owns_task,
+                               uint32_t taskset_ea, uint32_t taskid);
+
 int spu_workload_dispatch_async(const uint8_t* image, uint32_t image_size,
                                 uint32_t args_ea)
+{
+    /* Legacy callers: the taskset+taskid come from the single-slot globals the
+     * last cellSpursCreateTask set. */
+    extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+    return dispatch_async_impl(image, image_size, args_ea, 0,
+                               g_ydkj_real_taskset_ea, g_ydkj_real_taskid);
+}
+
+/* cellSpursCreateTask path: the taskset+taskid are passed explicitly. Reading
+ * the globals raced a second PPU thread's CreateTask -- PSASBR's menu creates
+ * tasks from two threads at once, and task 5 ran task 6's descriptor while 5's
+ * own work was never done (its caller then spun forever on the result word). */
+int spu_workload_dispatch_task_async(const uint8_t* image, uint32_t image_size,
+                                     uint32_t args_ea, uint32_t taskset_ea,
+                                     uint32_t taskid)
+{
+    return dispatch_async_impl(image, image_size, args_ea, 1, taskset_ea, taskid);
+}
+
+static int dispatch_async_impl(const uint8_t* image, uint32_t image_size,
+                               uint32_t args_ea, int owns_task,
+                               uint32_t taskset_ea, uint32_t taskid)
 {
     if (!image || image_size == 0) return 0;
 
@@ -1049,8 +1092,8 @@ int spu_workload_dispatch_async(const uint8_t* image, uint32_t image_size,
      * set the globals for THIS task). Reading them later in the async thread races
      * the next CreateTask overwriting the single-slot globals -- with two audio
      * tasks that made both run task 1's descriptor. */
-    { extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
-      j->taskset_ea = g_ydkj_real_taskset_ea; j->taskid = g_ydkj_real_taskid; }
+    j->taskset_ea = taskset_ea; j->taskid = taskid; j->owns_task = owns_task;
+    { extern unsigned long long ps3_ms_now(void); j->t_dispatch = ps3_ms_now(); }
     /* Capture the SPURS task r3 NOW (PPU thread, synchronous) from the game's
      * descriptor at eaContext+0x10 = {0x40-marker handle, workload EAs}; the
      * async SPU thread reading it later would race the PPU stack. word1 is
