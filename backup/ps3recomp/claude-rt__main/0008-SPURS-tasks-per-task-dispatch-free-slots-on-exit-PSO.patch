 libs/video/rsx_d3d12_backend.c    |  8 +++-
 runtime/spu/spu_lifted_job.h      |  8 ++++
 runtime/spu/spu_workload.c        | 47 ++++++++++++++++++-
 runtime/spu/spu_workload.h        |  7 +++
 runtime/syscalls/sys_ppu_thread.c |  6 ++-
