             ctx.gpr[3]._u32[1] = _LB(0x2784);
             ctx.gpr[3]._u32[2] = _LB(0x2788);
             ctx.gpr[3]._u32[3] = _LB(0x278C);
+            { static int _ta = -1; if (_ta < 0) _ta = getenv("SPU_TASKARG") ? 1 : 0;
+              if (_ta) fprintf(stderr, "[taskarg] img=%d r3={%08X %08X %08X %08X} r4={%08X %08X %08X %08X}\n",
+                               image_id, ctx.gpr[3]._u32[0], ctx.gpr[3]._u32[1], ctx.gpr[3]._u32[2],
+                               ctx.gpr[3]._u32[3], ctx.gpr[4]._u32[0], ctx.gpr[4]._u32[1],
+                               ctx.gpr[4]._u32[2], ctx.gpr[4]._u32[3]); }
         } else {
             ctx.gpr[3]._u32[0] = 0x00400000u;   /* 0x40 marker (>>16==64), DMA tag 0 */
             ctx.gpr[3]._u32[1] = args_ea;       /* eaContext -> r3.word1 */
@@ -314,6 +319,9 @@ static inline int32_t spu_run_lifted_job_abi(spu_lifted_entry_fn entry,
         spu_thread_publish_ctx(opts->spu_id, 0);   /* run over: ctx is a stack local */
     }
     if (local_store) memcpy(local_store, ctx.ls, SPU_LS_SIZE);  /* LS back out */
+    /* ctx is a stack local: drop it from the lock-line registry before the frame
+     * dies, or the next guest store to a reserved line writes into it. */
+    { extern void spu_coh_forget(spu_context* c); spu_coh_forget(&ctx); }
     return 0;
 }
 
