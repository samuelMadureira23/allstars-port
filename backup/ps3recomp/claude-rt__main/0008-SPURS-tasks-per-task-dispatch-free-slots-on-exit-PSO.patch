diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index baf6a8c..c10e3b6 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -71,6 +71,39 @@ static SpursWorkload s_workloads[CELL_SPURS_MAX_WORKLOAD];
 static SpursTask     s_tasks[CELL_SPURS_MAX_TASK];
 static u32           s_next_task_id = 0;
 
+/* cellSpursCreateTask runs on several PPU threads at once (PSASBR's menu creates
+ * from two), and the task table + the BE taskset bits are shared -- so slot
+ * allocation and release go through one lock. */
+#ifdef _WIN32
+static SRWLOCK s_task_lock = SRWLOCK_INIT;
+#define TASK_LOCK()   AcquireSRWLockExclusive(&s_task_lock)
+#define TASK_UNLOCK() ReleaseSRWLockExclusive(&s_task_lock)
+#else
+static pthread_mutex_t s_task_lock = PTHREAD_MUTEX_INITIALIZER;
+#define TASK_LOCK()   pthread_mutex_lock(&s_task_lock)
+#define TASK_UNLOCK() pthread_mutex_unlock(&s_task_lock)
+#endif
+
+/* Called from the SPU host thread when a CreateTask task's program returns:
+ * the task has exited, so its id is free again (real SPURS reuses it). */
+void cellSpurs_task_exited(uint32_t taskset_ea, uint32_t taskid, int32_t rc)
+{
+    if (taskid >= CELL_SPURS_MAX_TASK) return;
+    TASK_LOCK();
+    s_tasks[taskid].completed = 1;
+    s_tasks[taskid].active = 0;
+    s_tasks[taskid].exitCode = rc;
+    s_tasks[taskid].in_use = 0;
+    if (taskset_ea) {
+        spurs_bitset_clear(taskset_ea + CSTS_RUNNING, taskid);
+        spurs_bitset_clear(taskset_ea + CSTS_READY, taskid);
+        spurs_bitset_clear(taskset_ea + CSTS_PENDING_READY, taskid);
+        spurs_bitset_clear(taskset_ea + CSTS_ENABLED, taskid);
+        spurs_bitset_clear(taskset_ea + CSTS_WAITING, taskid);
+    }
+    TASK_UNLOCK();
+}
+
 /* ---------------------------------------------------------------------------
  * Event flag sync side table
  *
@@ -814,6 +847,7 @@ s32 cellSpursCreateTask(CellSpursTaskset* taskset, CellSpursTaskId* taskId,
     }
 
     /* Find a free task slot */
+    TASK_LOCK();
     for (u32 i = 0; i < CELL_SPURS_MAX_TASK; i++) {
         if (!s_tasks[i].in_use) {
             s_tasks[i].in_use = 1;
@@ -847,9 +881,9 @@ s32 cellSpursCreateTask(CellSpursTaskset* taskset, CellSpursTaskId* taskId,
             g_ydkj_real_taskset_ea = taskset_ea;
             g_ydkj_real_taskid     = i;
 
-            printf("[cellSpurs] CreateTask(id=%u, entry=%p, arg=%08X %08X %08X %08X"
+            printf("[cellSpurs] CreateTask(id=%u #%u, entry=%p, arg=%08X %08X %08X %08X"
                    " ctx=0x%08X lsp=%08X %08X %08X %08X)\n",
-                   s_tasks[i].id, elf, task_arg[0], task_arg[1], task_arg[2], task_arg[3],
+                   i, s_tasks[i].id, elf, task_arg[0], task_arg[1], task_arg[2], task_arg[3],
                    context_ea, task_lsp[0], task_lsp[1], task_lsp[2], task_lsp[3]);
 
             /* One-shot: dump the memory the task argument points at, to find the
@@ -921,14 +955,21 @@ s32 cellSpursCreateTask(CellSpursTaskset* taskset, CellSpursTaskId* taskId,
                 size_t sz = spu_elf_image_size(host_elf, 2u * 1024 * 1024);
                 if (sz)
                     /* Async: SPURS tasks are persistent workers — running them
-                     * inline would block this PPU thread forever (deadlock). */
-                    spu_workload_dispatch_async(host_elf, (uint32_t)sz,
-                                                (uint32_t)(uintptr_t)context);
+                     * inline would block this PPU thread forever (deadlock).
+                     * Pass THIS task's taskset+slot: the globals above are
+                     * shared with every other PPU thread creating tasks. */
+                    spu_workload_dispatch_task_async(host_elf, (uint32_t)sz,
+                                                     (uint32_t)(uintptr_t)context,
+                                                     taskset_ea, i);
             }
+            TASK_UNLOCK();
             return CELL_OK;
         }
     }
+    TASK_UNLOCK();
 
+    fprintf(stderr, "[cellSpurs] CreateTask NOMEM: all %d task slots in use\n",
+            CELL_SPURS_MAX_TASK);
     return CELL_SPURS_TASK_ERROR_NOMEM;
 }
 
@@ -1069,19 +1110,19 @@ s32 cellSpursJoinTask(CellSpursTaskset* taskset, CellSpursTaskId taskId,
 
     printf("[cellSpurs] JoinTask(id=%u)\n", taskId);
 
-    /* Find the task and mark as completed */
-    for (u32 i = 0; i < CELL_SPURS_MAX_TASK; i++) {
-        if (s_tasks[i].in_use && s_tasks[i].id == taskId) {
-            s_tasks[i].completed = 1;
-            s_tasks[i].active = 0;
-            if (exitCode_h)
-                *exitCode_h = s_tasks[i].exitCode;
-            s_tasks[i].in_use = 0;
-            return CELL_OK;
-        }
-    }
-
-    return CELL_SPURS_TASK_ERROR_SRCH;
+    /* The id the guest holds is the SLOT index (see cellSpursCreateTask), not
+     * the global counter -- once slots are reused the two differ. A task whose
+     * program already returned was released by cellSpurs_task_exited and still
+     * reports its exit code here. */
+    if (taskId >= CELL_SPURS_MAX_TASK) return CELL_SPURS_TASK_ERROR_SRCH;
+    TASK_LOCK();
+    s_tasks[taskId].completed = 1;
+    s_tasks[taskId].active = 0;
+    if (exitCode_h)
+        *exitCode_h = (s32)__builtin_bswap32((u32)s_tasks[taskId].exitCode);
+    s_tasks[taskId].in_use = 0;
+    TASK_UNLOCK();
+    return CELL_OK;
 }
 
 s32 cellSpursSendSignal(CellSpursTaskset* taskset, CellSpursTaskId taskId)
diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
