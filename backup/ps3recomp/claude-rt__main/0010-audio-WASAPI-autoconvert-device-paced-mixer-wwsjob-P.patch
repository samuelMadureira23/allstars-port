 {
@@ -140,46 +139,230 @@ static int pad_host_window_focused(void)
     return pid == GetCurrentProcessId();
 }
 
+/* Keyboard targets: the 16 digital buttons (CELL_PAD_CTRL_* bit index) and
+ * the eight half-axes of the two sticks. */
+enum {
+    PADK_LS_UP = 16, PADK_LS_DOWN, PADK_LS_LEFT, PADK_LS_RIGHT,
+    PADK_RS_UP, PADK_RS_DOWN, PADK_RS_LEFT, PADK_RS_RIGHT,
+    PADK_NUM_TARGETS
+};
+static const struct { const char* name; int target; } s_padk_targets[] = {
+    { "select", 0 }, { "l3", 1 }, { "r3", 2 }, { "start", 3 },
+    { "up", 4 }, { "right", 5 }, { "down", 6 }, { "left", 7 },
+    { "l2", 8 }, { "r2", 9 }, { "l1", 10 }, { "r1", 11 },
+    { "triangle", 12 }, { "circle", 13 }, { "cross", 14 }, { "square", 15 },
+    { "ls_up", PADK_LS_UP }, { "ls_down", PADK_LS_DOWN },
+    { "ls_left", PADK_LS_LEFT }, { "ls_right", PADK_LS_RIGHT },
+    { "rs_up", PADK_RS_UP }, { "rs_down", PADK_RS_DOWN },
+    { "rs_left", PADK_RS_LEFT }, { "rs_right", PADK_RS_RIGHT },
+};
+static const struct { const char* name; int vk; } s_padk_keys[] = {
+    { "up", VK_UP }, { "down", VK_DOWN }, { "left", VK_LEFT }, { "right", VK_RIGHT },
+    { "enter", VK_RETURN }, { "return", VK_RETURN }, { "space", VK_SPACE },
+    { "tab", VK_TAB }, { "esc", VK_ESCAPE }, { "escape", VK_ESCAPE },
+    { "backspace", VK_BACK }, { "shift", VK_SHIFT }, { "lshift", VK_LSHIFT },
+    { "rshift", VK_RSHIFT }, { "ctrl", VK_CONTROL }, { "lctrl", VK_LCONTROL },
+    { "rctrl", VK_RCONTROL }, { "alt", VK_MENU }, { "lalt", VK_LMENU },
+    { "ralt", VK_RMENU }, { "insert", VK_INSERT }, { "delete", VK_DELETE },
+    { "home", VK_HOME }, { "end", VK_END }, { "pageup", VK_PRIOR },
+    { "pagedown", VK_NEXT }, { "capslock", VK_CAPITAL },
+    { ";", VK_OEM_1 }, { "semicolon", VK_OEM_1 }, { "/", VK_OEM_2 },
+    { "slash", VK_OEM_2 }, { "`", VK_OEM_3 }, { "[", VK_OEM_4 },
+    { "\\", VK_OEM_5 }, { "]", VK_OEM_6 }, { "'", VK_OEM_7 },
+    { "quote", VK_OEM_7 }, { ",", VK_OEM_COMMA }, { "comma", VK_OEM_COMMA },
+    { ".", VK_OEM_PERIOD }, { "period", VK_OEM_PERIOD }, { "-", VK_OEM_MINUS },
+    { "minus", VK_OEM_MINUS }, { "=", VK_OEM_PLUS }, { "equals", VK_OEM_PLUS },
+};
+
+#define PADK_MAX_KEYS 4
+static int s_padk_map[PADK_NUM_TARGETS][PADK_MAX_KEYS];   /* VK codes, 0 = none */
+
+static int padk_parse_key(const char* k)
+{
+    char buf[32];
+    size_t n = 0;
+    for (; k[n] && n < sizeof buf - 1; n++)
+        buf[n] = (char)((k[n] >= 'A' && k[n] <= 'Z') ? k[n] + 32 : k[n]);
+    buf[n] = 0;
+    if (n == 0) return 0;
+    if (n == 1 && ((buf[0] >= 'a' && buf[0] <= 'z') || (buf[0] >= '0' && buf[0] <= '9')))
+        return (buf[0] >= 'a') ? buf[0] - 32 : buf[0];
+    if (buf[0] == 'f' && n <= 3 && atoi(buf + 1) >= 1 && atoi(buf + 1) <= 12)
+        return VK_F1 + atoi(buf + 1) - 1;
+    if (!strncmp(buf, "num", 3) && n == 4 && buf[3] >= '0' && buf[3] <= '9')
+        return VK_NUMPAD0 + (buf[3] - '0');
+    if (!strncmp(buf, "vk", 2) && n > 2)
+        return (int)strtol(buf + 2, NULL, 16);
+    for (unsigned i = 0; i < sizeof s_padk_keys / sizeof s_padk_keys[0]; i++)
+        if (!strcmp(buf, s_padk_keys[i].name)) return s_padk_keys[i].vk;
+    return 0;
+}
+
+static char* padk_trim(char* t)
+{
+    while (*t == ' ' || *t == '\t') t++;
+    char* e = t + strlen(t);
+    while (e > t && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) *--e = 0;
+    return t;
+}
+
+/* One binding: "target = key[, key...]". Replaces that target's keys; an
+ * empty right-hand side unbinds it. Returns 0 when the line is not a binding. */
+static int padk_apply_line(char* line)
+{
+    char* hash = strchr(line, '#');
+    if (hash) *hash = 0;
+    char* eq = strchr(line, '=');
+    if (!eq) return 0;
+    *eq = 0;
+    char* name = padk_trim(line);
+    for (char* c = name; *c; c++) if (*c >= 'A' && *c <= 'Z') *c += 32;
+    int target = -1;
+    for (unsigned i = 0; i < sizeof s_padk_targets / sizeof s_padk_targets[0]; i++)
+        if (!strcmp(name, s_padk_targets[i].name)) target = s_padk_targets[i].target;
+    if (target < 0) {
+        fprintf(stderr, "[cellPad] keymap: unknown button '%s'\n", name);
+        return 0;
+    }
+    memset(s_padk_map[target], 0, sizeof s_padk_map[target]);
+    int nk = 0;
+    char* save = NULL;
+    for (char* tok = strtok_s(eq + 1, ",", &save); tok; tok = strtok_s(NULL, ",", &save)) {
+        char* kname = padk_trim(tok);
+        if (!*kname) continue;
+        int vk = padk_parse_key(kname);
+        if (!vk) { fprintf(stderr, "[cellPad] keymap: unknown key '%s'\n", kname); continue; }
+        if (nk < PADK_MAX_KEYS) s_padk_map[target][nk++] = vk;
+    }
+    return 1;
+}
+
+/* Default map, laid out for a fighting game (PlayStation All-Stars: square /
+ * triangle / circle attack, cross jumps, R1 blocks, L1 picks up, R2 super):
+ *   WASD          = left stick + d-pad (movement and menus)
+ *   arrow keys    = right stick (evade); also the d-pad
+ *   J / I / L / K = square / triangle / circle / cross (the face-button
+ *                   diamond, same shape on the keyboard); Space = cross too
+ *   O = R1, U = L1, P = R2, Y = L2, Q = L3, E = R3
+ *   Enter = START, Backspace = SELECT, Esc = circle (menu back) */
+static const char* const s_padk_default[] = {
+    "up = w, up", "down = s, down", "left = a, left", "right = d, right",
+    "ls_up = w", "ls_down = s", "ls_left = a", "ls_right = d",
+    "rs_up = up", "rs_down = down", "rs_left = left", "rs_right = right",
+    "square = j", "triangle = i", "circle = l, esc", "cross = k, space",
+    "r1 = o", "l1 = u", "r2 = p", "l2 = y", "l3 = q", "r3 = e",
+    "start = enter", "select = backspace",
+};
+
+static int padk_load_file(const char* path)
+{
+    FILE* f = fopen(path, "r");
+    if (!f) return 0;
+    char line[256];
+    int n = 0;
+    while (fgets(line, sizeof line, f)) {
+        char* t = padk_trim(line);
+        if (*t == '[' || *t == ';' || *t == 0) continue;   /* [section] / comment */
+        n += padk_apply_line(t);
+    }
+    fclose(f);
+    printf("[cellPad] keymap: %d binding(s) from %s\n", n, path);
+    return 1;
+}
+
+/* Default map, then keymap.ini (PAD_KEYMAP_FILE, else next to the .exe, else
+ * the working directory), then PAD_KEYMAP="cross=k,space;square=j;..." on top. */
+static void pad_keymap_load(void)
+{
+    char buf[256];
+    for (unsigned i = 0; i < sizeof s_padk_default / sizeof s_padk_default[0]; i++) {
+        strncpy(buf, s_padk_default[i], sizeof buf - 1); buf[sizeof buf - 1] = 0;
+        padk_apply_line(buf);
+    }
+    const char* file = getenv("PAD_KEYMAP_FILE");
+    if (file) {
+        if (!padk_load_file(file))
+            fprintf(stderr, "[cellPad] keymap: cannot open PAD_KEYMAP_FILE=%s\n", file);
+    } else {
+        char exe[MAX_PATH];
+        DWORD n = GetModuleFileNameA(NULL, exe, MAX_PATH);
+        char* slash = (n && n < MAX_PATH) ? strrchr(exe, '\\') : NULL;
+        int loaded = 0;
+        if (slash && (size_t)(slash - exe) + sizeof "\\keymap.ini" < MAX_PATH) {
+            strcpy(slash, "\\keymap.ini");
+            loaded = padk_load_file(exe);
+        }
+        if (!loaded) padk_load_file("keymap.ini");
+    }
+    const char* inl = getenv("PAD_KEYMAP");
+    if (inl) {
+        char tmp[1024];
+        strncpy(tmp, inl, sizeof tmp - 1); tmp[sizeof tmp - 1] = 0;
+        char* save = NULL;
+        for (char* b = strtok_s(tmp, ";", &save); b; b = strtok_s(NULL, ";", &save)) {
+            strncpy(buf, b, sizeof buf - 1); buf[sizeof buf - 1] = 0;
+            padk_apply_line(buf);
+        }
+    }
+}
+
+static int padk_down(int target)
+{
+    for (int k = 0; k < PADK_MAX_KEYS && s_padk_map[target][k]; k++)
+        if (GetAsyncKeyState(s_padk_map[target][k]) & 0x8000) return 1;
+    return 0;
+}
+
+static u8 padk_axis(int neg, int pos)
+{
+    int a = padk_down(neg), b = padk_down(pos);
+    return (u8)(a == b ? 128 : a ? 0 : 255);
+}
+
 static void pad_poll_keyboard(void)
 {
     static int off = -1;
-    if (off < 0) off = getenv("PAD_NO_KEYBOARD") ? 1 : 0;
+    if (off < 0) {
+        off = getenv("PAD_NO_KEYBOARD") ? 1 : 0;
+        if (!off) pad_keymap_load();
+    }
     if (off) return;
 
     PadHostState* hs = &s_host_state[0];
     if (!pad_host_window_focused()) {
         /* Release everything on focus loss, or a key held while alt-tabbing
          * would stay down forever. */
-        hs->buttons = 0;
+        memset(hs, 0, sizeof *hs);
         hs->analog_lx = hs->analog_ly = 128;
         hs->analog_rx = hs->analog_ry = 128;
         hs->connected = 1;
         return;
     }
 
-    static const struct { int vk; u16 btn; } map[] = {
-        { VK_UP,     CELL_PAD_CTRL_UP },      { VK_DOWN,  CELL_PAD_CTRL_DOWN },
-        { VK_LEFT,   CELL_PAD_CTRL_LEFT },    { VK_RIGHT, CELL_PAD_CTRL_RIGHT },
-        { 'Z',       CELL_PAD_CTRL_CROSS },   { 'X',      CELL_PAD_CTRL_CIRCLE },
-        { 'A',       CELL_PAD_CTRL_SQUARE },  { 'S',      CELL_PAD_CTRL_TRIANGLE },
-        { 'Q',       CELL_PAD_CTRL_L1 },      { 'W',      CELL_PAD_CTRL_R1 },
-        { '1',       CELL_PAD_CTRL_L2 },      { '2',      CELL_PAD_CTRL_R2 },
-        { VK_RETURN, CELL_PAD_CTRL_START },   { VK_TAB,   CELL_PAD_CTRL_SELECT },
-    };
