diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index fdf9044..037bee3 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -222,6 +222,13 @@ static IAudioClient*        s_wasapi_client = NULL;
 static IAudioRenderClient*  s_wasapi_render = NULL;
 static HANDLE               s_wasapi_event  = NULL;
 static UINT32               s_wasapi_buf_frames = 0;
+/* Fill target in frames: the mixer tops the device buffer up to this many
+ * queued frames, one 256-sample block at a time (device period + 3 blocks). */
+static UINT32               s_wasapi_target = 0;
+/* Set when the endpoint goes away (unplugged, default device switched...):
+ * the mixer then paces itself off the clock so the game keeps its audio
+ * events at 187.5 blocks/s even with no device. */
+static volatile int         s_wasapi_failed = 0;
 
 static int audio_backend_init(void)
 {
@@ -267,22 +274,37 @@ static int audio_backend_init(void)
     wfx.nAvgBytesPerSec = wfx.nSamplesPerSec * wfx.nBlockAlign;
     wfx.cbSize          = 0;
 
-    /* Request event-driven mode with a ~20ms buffer */
-    REFERENCE_TIME buf_duration = 200000; /* 20ms in 100ns units */
+    /* Event-driven shared mode with a 40ms buffer. The mixer only keeps
+     * ~period + 3 blocks queued (see s_wasapi_target), so the latency is that,
+     * not the buffer size. AUTOCONVERTPCM + SRC_DEFAULT_QUALITY let the audio
+     * engine convert our 48 kHz float stereo to whatever the endpoint's mix
+     * format is; without them Initialize fails with AUDCLNT_E_UNSUPPORTED_FORMAT
+     * on a device mixing at 44.1 kHz (or 96 kHz, or 5.1) and the game is mute. */
+#ifndef AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM
+#define AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM 0x80000000
+#endif
+#ifndef AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY
+#define AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY 0x08000000
+#endif
+    const DWORD conv = AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM |
+                       AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY;
+    REFERENCE_TIME buf_duration = 400000; /* 40ms in 100ns units */
     s_wasapi_event = CreateEventW(NULL, FALSE, FALSE, NULL);
 
     hr = s_wasapi_client->lpVtbl->Initialize(
         s_wasapi_client,
         AUDCLNT_SHAREMODE_SHARED,
-        AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+        AUDCLNT_STREAMFLAGS_EVENTCALLBACK | conv,
         buf_duration, 0, &wfx, NULL);
 
     if (FAILED(hr)) {
+        printf("[cellAudio] WASAPI event-mode Initialize failed: 0x%08lX, "
+               "retrying in polled mode\n", hr);
         /* Fallback: try without event callback */
         hr = s_wasapi_client->lpVtbl->Initialize(
             s_wasapi_client,
             AUDCLNT_SHAREMODE_SHARED,
-            0, buf_duration, 0, &wfx, NULL);
+            conv, buf_duration, 0, &wfx, NULL);
         if (FAILED(hr)) {
             printf("[cellAudio] WASAPI Initialize failed: 0x%08lX\n", hr);
             s_wasapi_client->lpVtbl->Release(s_wasapi_client);
@@ -298,6 +320,18 @@ static int audio_backend_init(void)
     }
 
     s_wasapi_client->lpVtbl->GetBufferSize(s_wasapi_client, &s_wasapi_buf_frames);
+    {
+        REFERENCE_TIME def_period = 100000, min_period = 0;   /* 10ms default */
+        s_wasapi_client->lpVtbl->GetDevicePeriod(s_wasapi_client, &def_period, &min_period);
+        UINT32 period_frames = (UINT32)((def_period * CELL_AUDIO_SAMPLE_RATE + 9999999) / 10000000);
+        s_wasapi_target = period_frames + 3 * CELL_AUDIO_BLOCK_SAMPLES;
+        if (s_wasapi_target > s_wasapi_buf_frames)
+            s_wasapi_target = s_wasapi_buf_frames;
+        printf("[cellAudio] WASAPI up: %s, buffer=%u frames, period=%u frames, "
+               "fill target=%u frames\n", s_wasapi_event ? "event" : "polled",
+               (unsigned)s_wasapi_buf_frames, (unsigned)period_frames,
+               (unsigned)s_wasapi_target);
+    }
 
     hr = s_wasapi_client->lpVtbl->GetService(
         s_wasapi_client, &IID_IAudioRenderClient, (void**)&s_wasapi_render);
@@ -507,37 +541,100 @@ static void audio_notify_event_queues(void)
 }
 
 #ifdef _WIN32
+#include <mmsystem.h>
+#pragma comment(lib, "winmm.lib")
+
+/* Mix one block, publish it to the device and wake the game's audio thread.
+ * Called exactly once per 256-sample block the device (or the clock) consumes,
+ * so the game sees CELL_AUDIO_EVENT_MIX at the real 187.5 blocks/s. */
+static void audio_emit_block(int submit)
+{
+    audio_mix_one_block();
+    /* AUDIO_PEAK=1: report the mixed block's peak amplitude periodically so
+     * "is any port producing sound" is answerable (LBP Bink movie audio). */
+    { static int _ap = -1; if (_ap < 0) _ap = getenv("AUDIO_PEAK") ? 1 : 0;
+      if (_ap) { static unsigned _n = 0; float pk = 0.0f;
+        for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+            float a = s_mix_buffer[i]; if (a < 0) a = -a; if (a > pk) pk = a; }
+        if ((++_n % 200) == 0 || (pk > 0.001f && _n < 40))
+            fprintf(stderr, "[audio-peak] block#%u peak=%.4f\n", _n, pk); } }
+    if (submit)
+        audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+    audio_notify_event_queues();
+}
+
+/* Blocks of 256 samples at 48 kHz elapsed since t0 by the performance counter. */
+static u64 audio_qpc_blocks(LARGE_INTEGER t0, LARGE_INTEGER freq)
+{
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    u64 dt = (u64)(now.QuadPart - t0.QuadPart);
+    u64 f = (u64)freq.QuadPart * CELL_AUDIO_BLOCK_SAMPLES;
+    return (dt / f) * CELL_AUDIO_SAMPLE_RATE +
+           (dt % f) * CELL_AUDIO_SAMPLE_RATE / f;
+}
+
 static unsigned __stdcall audio_mix_thread_func(void* arg)
 {
     (void)arg;
     printf("[cellAudio] Mixing thread started\n");
+    /* 1ms scheduler granularity for the clock-paced and polled paths (the
+     * default Sleep resolution, ~15.6ms, is three whole blocks). */
+    timeBeginPeriod(1);
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
 
-    while (s_mix_thread_running) {
-        /* Mix and submit one block */
-        audio_mix_one_block();
-        /* AUDIO_PEAK=1: report the mixed block's peak amplitude periodically so
-         * "is any port producing sound" is answerable (LBP Bink movie audio). */
-        { static int _ap = -1; if (_ap < 0) _ap = getenv("AUDIO_PEAK") ? 1 : 0;
-          if (_ap) { static unsigned _n = 0; float pk = 0.0f;
-            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
-                float a = s_mix_buffer[i]; if (a < 0) a = -a; if (a > pk) pk = a; }
-            if ((++_n % 200) == 0 || (pk > 0.001f && _n < 40))
-                fprintf(stderr, "[audio-peak] block#%u peak=%.4f\n", _n, pk); } }
-        audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+    LARGE_INTEGER freq, t0;
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&t0);
+    u64 clock_done = 0;
+    int clock_mode = -1;     /* -1 = undecided; logged on every change */
 
-        /* Notify event queues */
-        audio_notify_event_queues();
-
-        /* Wait approximately one audio period (~5.333ms).
-         * Adjust based on how much is queued to avoid buffer overrun. */
-        u32 queued = audio_backend_queued_samples();
-        if (queued > CELL_AUDIO_BLOCK_SAMPLES * 4) {
-            Sleep(5);
-        } else {
-            Sleep(2);
+    while (s_mix_thread_running) {
+#if AUDIO_BACKEND_WASAPI
+        if (s_wasapi_render && !s_wasapi_failed) {
+            if (clock_mode != 0) { clock_mode = 0;
+                printf("[cellAudio] mixer paced by the WASAPI device clock\n"); }
+            if (s_wasapi_event) WaitForSingleObject(s_wasapi_event, 20);
+            else                Sleep(1);
+            UINT32 pad = 0;
+            HRESULT hr = s_wasapi_client->lpVtbl->GetCurrentPadding(s_wasapi_client, &pad);
+            if (FAILED(hr)) {
+                printf("[cellAudio] WASAPI device lost (0x%08lX): pacing by clock\n", hr);
+                s_wasapi_failed = 1;
+                continue;
+            }
+            /* Top the device up block by block: every block the device has
+             * consumed is one block mixed and one event delivered. */
+            int n = 0;
+            while (s_mix_thread_running &&
+                   pad + CELL_AUDIO_BLOCK_SAMPLES <= s_wasapi_target && n < 16) {
+                audio_emit_block(1);
+                pad += CELL_AUDIO_BLOCK_SAMPLES;
+                n++;
+            }
+            continue;
+        }
+#endif
+        /* No device (init failed, device lost, SDL backend): keep the game's
+         * audio clock at 187.5 blocks/s from the performance counter. */
+        if (clock_mode != 1) { clock_mode = 1;
+            printf("[cellAudio] mixer paced by the system clock (187.5 blocks/s)\n");
+            QueryPerformanceCounter(&t0); clock_done = 0; }
+        Sleep(1);
+        u64 due = audio_qpc_blocks(t0, freq);
+        if (due > clock_done + 16)       /* stalled (debugger, suspend): resync */
+            clock_done = due - 1;
+        while (s_mix_thread_running && clock_done < due) {
+#if AUDIO_BACKEND_WASAPI
+            audio_emit_block(0);
+#else
+            audio_emit_block(1);
+#endif
+            clock_done++;
         }
     }
 
+    timeEndPeriod(1);
     printf("[cellAudio] Mixing thread stopped\n");
     return 0;
 }
